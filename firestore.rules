rules_version = '2';

// RCMI — Resin Car Model Indonesia
// Two account types (users.accountType):
//   - "member"  (RCMI member; older accounts without the field count as members)
//   - "general" (signed-in non-member, approved by an admin)
// Who can do what:
//   - Everyone, signed in or not: browse the market.
//   - Approved members AND general users: post in the market, see sellers' WhatsApp, events + RSVP, view the collection.
//   - Approved members only: member list & profiles, member card, monthly dues, adding cars to the collection.
//   - Admins approve sign-ups, assign member numbers and manage events.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function approved() { return hasProfile() && me().status == 'approved'; }
    function admin() { return approved() && me().role == 'admin'; }
    function member() { return approved() && me().get('accountType', 'member') == 'member'; }
    function str(v, max) { return v is string && v.size() <= max; }
    function photosOk(p) { return p is list && p.size() <= 3; }
    // Pre-registered members: admins add invites/{gmail} → { rosterId, memberNo }.
    // A verified Google account with that email activates itself without waiting for approval.
    function myEmail() { return request.auth.token.email.lower(); }
    function invitePath() { return /databases/$(database)/documents/invites/$(myEmail()); }
    function hasInvite() { return signedIn() && request.auth.token.email_verified == true && exists(invitePath()); }
    function invite() { return get(invitePath()).data; }
    // Phone matching: phoneInvites/{62812…} → { rosterId, memberNo }. The member types the number they registered.
    function phoneInvite(key) { return get(/databases/$(database)/documents/phoneInvites/$(key)).data; }
    function rosterDoc(id) { return get(/databases/$(database)/documents/roster/$(id)).data; }
    function rosterFree(id) { return !('claimedBy' in rosterDoc(id)) || rosterDoc(id).claimedBy == null; }

    // ---------- Members ----------
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || member() || admin();

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'member'
        && request.resource.data.get('accountType', 'member') in ['member', 'general']
        && request.resource.data.email == request.auth.token.email
        && str(request.resource.data.displayName, 80)
        && str(request.resource.data.city, 60)
        && (
          // Normal sign-up: waits for an admin.
          (request.resource.data.keys().hasOnly(['displayName','email','photoURL','city','instagram','whatsapp','bio','status','role','createdAt','phoneKey','accountType'])
            && request.resource.data.status == 'pending')
          ||
          // Registered phone number: active straight away as that member (each record can be claimed once).
          (request.resource.data.keys().hasOnly(['displayName','email','photoURL','city','instagram','whatsapp','bio','status','role','createdAt','memberNo','rosterId','approvedAt','phoneKey','accountType'])
            && request.resource.data.status == 'approved'
            && request.resource.data.get('accountType', 'member') == 'member'
            && request.resource.data.phoneKey is string
            && exists(/databases/$(database)/documents/phoneInvites/$(request.resource.data.phoneKey))
            && request.resource.data.rosterId == phoneInvite(request.resource.data.phoneKey).rosterId
            && request.resource.data.memberNo == phoneInvite(request.resource.data.phoneKey).memberNo
            && rosterFree(request.resource.data.rosterId))
          ||
          // Registered Google email: same, keyed by the verified email.
          (hasInvite()
            && request.resource.data.keys().hasOnly(['displayName','email','photoURL','city','instagram','whatsapp','bio','status','role','createdAt','memberNo','rosterId','approvedAt','accountType'])
            && request.resource.data.status == 'approved'
            && request.resource.data.get('accountType', 'member') == 'member'
            && request.resource.data.memberNo == invite().memberNo
            && request.resource.data.rosterId == invite().rosterId
            && rosterFree(invite().rosterId))
        );

      // Members can edit their own profile details, never their status, role or number.
      allow update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayName','city','instagram','whatsapp','bio','photoURL','updatedAt'])
          && str(request.resource.data.displayName, 80))
        || admin();

      allow delete: if admin();
    }

    // Seller contact (name + WhatsApp) for the market — readable by any approved account, written by its owner.
    match /contacts/{uid} {
      allow read: if approved();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'whatsapp', 'instagram'])
        && str(request.resource.data.name, 80) && str(request.resource.data.whatsapp, 20);
    }

    // Imported roster (from the Google Form): number, name, province — visible to members.
    match /roster/{id} {
      allow read: if member() || admin();
      allow write: if admin();
      // A member activated by phone/email links their account to their own (still unclaimed) record.
      allow update: if approved() && me().rosterId == id
        && (!('claimedBy' in resource.data) || resource.data.claimedBy == null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy'])
        && request.resource.data.claimedBy == request.auth.uid;
    }
    // Phone invites: looked up by the exact number someone types; never listable except by admins.
    match /phoneInvites/{phone} {
      allow get: if signedIn();
      allow list, write: if admin();
    }
    // Email invites: the signed-in person can read only the invite for their own verified email.
    match /invites/{email} {
      allow get: if signedIn() && request.auth.token.email_verified == true && email == myEmail();
      allow list, write: if admin();
    }
    // Phone numbers and T-shirt orders — admins only.
    match /rosterPrivate/{id} {
      allow read, write: if admin();
    }

    // ---------- Monthly dues ----------
    // Payment settings (bank account, amount, due day) — members read, admins edit.
    match /settings/{id} {
      allow read: if member() || admin();
      allow write: if admin();
    }
    // One document per member per month: dues/{rosterId}_{YYYY-MM}.
    // Members see and submit only their own; admins confirm, reject, waive or mark paid.
    match /dues/{dueId} {
      function mine(d) { return approved() && d.rosterId == me().rosterId; }
      function validSubmit(d) {
        return d.uid == request.auth.uid
          && d.status == 'pending'
          && d.month is string && d.month.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
          && dueId == d.rosterId + '_' + d.month
          && d.proof is string && d.proof.size() < 400000;
      }
      allow read: if admin() || mine(resource.data);
      allow create: if admin() || (mine(request.resource.data) && validSubmit(request.resource.data));
      allow update: if admin() || (mine(resource.data) && resource.data.status != 'paid'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proof','note','submittedAt','status','uid','name','memberNo'])
        && validSubmit(request.resource.data));
      allow delete: if admin();
    }

    // ---------- Finance (Laba Rugi) ----------
    // The treasurer's ledger (imported from the KEUANGAN RCMI sheet).
    // Members can view the report (finance/ledger); only admins import/sync and see the sheet link (finance/source).
    match /finance/{id} {
      allow read: if admin() || (id == 'ledger' && member());
      allow write: if admin();
    }

    // Member-number counter, managed by admins during approval.
    match /counters/{id} {
      allow read, write: if admin();
    }

    // ---------- Collection showcase ----------
    match /cars/{carId} {
      allow read: if approved();
      allow create: if member()
        && request.resource.data.ownerUid == request.auth.uid
        && str(request.resource.data.name, 100)
        && photosOk(request.resource.data.photos);
      allow update: if (approved() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && photosOk(request.resource.data.photos)) || admin();
      allow delete: if (approved() && resource.data.ownerUid == request.auth.uid) || admin();
    }

    // ---------- Events & meetups ----------
    match /events/{eventId} {
      allow read: if approved();
      allow write: if admin();

      match /rsvps/{uid} {
        allow read: if approved();
        allow create, delete: if approved() && request.auth.uid == uid;
      }
    }

    // ---------- Marketplace / trade ----------
    // Public market: anyone can browse; only approved members post. Phone numbers never stored in listings.
    match /listings/{listingId} {
      allow read: if true;
      allow create: if approved()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.type in ['sell','trade','wanted']
        && !('ownerWhatsapp' in request.resource.data)
        && str(request.resource.data.title, 100)
        && photosOk(request.resource.data.photos);
      allow update: if (approved() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && photosOk(request.resource.data.photos)) || admin();
      allow delete: if (approved() && resource.data.ownerUid == request.auth.uid) || admin();
    }
  }
}
