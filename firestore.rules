rules_version = '2';

// RCMI — Resin Car Model Indonesia
// Two account types (users.accountType):
//   - "member"  (RCMI member; older accounts without the field count as members)
//   - "general" (signed-in non-member, approved by an admin)
// Who can do what:
//   - Everyone, signed in or not: browse the market.
//   - Approved members AND general users: post in the market, see sellers' WhatsApp, events + RSVP, view the collection.
//   - Approved members only: member list & profiles, member card, monthly dues, adding cars to the collection.
//   - Admins approve sign-ups, assign member numbers and manage events.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function approved() { return hasProfile() && me().status == 'approved'; }
    function admin() { return approved() && me().role == 'admin'; }
    // Moderator: approve/reject general users, approve listing delete requests, delete posts, deactivate accounts.
    function mod() { return approved() && me().role == 'moderator'; }
    function staff() { return admin() || mod(); }
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function member() { return approved() && me().get('accountType', 'member') == 'member'; }
    function str(v, max) { return v is string && v.size() <= max; }
    function photosOk(p) { return p is list && p.size() <= 3; }
    // Collection posts: up to 10 photos you can swipe through (all inside the 1 MB document).
    function carPhotosOk(p) { return p is list && p.size() <= 10; }
    // A post's content can be edited only once: the edit must stamp editedAt, and a post that has it can't be edited again.
    function editOnce(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys)
        || (!('editedAt' in resource.data) && request.resource.data.editedAt == request.time);
    }
    // Pre-registered members: admins add invites/{gmail} → { rosterId, memberNo }.
    // A verified Google account with that email activates itself without waiting for approval.
    function myEmail() { return request.auth.token.email.lower(); }
    function invitePath() { return /databases/$(database)/documents/invites/$(myEmail()); }
    function hasInvite() { return signedIn() && request.auth.token.email_verified == true && exists(invitePath()); }
    function invite() { return get(invitePath()).data; }
    // Phone matching: phoneInvites/{62812…} → { rosterId, memberNo }. The member types the number they registered.
    function phoneInvite(key) { return get(/databases/$(database)/documents/phoneInvites/$(key)).data; }
    function rosterDoc(id) { return get(/databases/$(database)/documents/roster/$(id)).data; }
    function rosterFree(id) { return !('claimedBy' in rosterDoc(id)) || rosterDoc(id).claimedBy == null; }

    // ---------- Members ----------
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || member() || staff();

      allow create: if signedIn() && request.auth.uid == uid
        // Blocked by an admin (by Google email or phone number): can't register again.
        && !exists(/databases/$(database)/documents/blocked/$(myEmail()))
        && (!('phoneKey' in request.resource.data) || !exists(/databases/$(database)/documents/blockedPhones/$(request.resource.data.phoneKey)))
        && request.resource.data.role == 'member'
        && request.resource.data.get('accountType', 'member') in ['member', 'general']
        && request.resource.data.email == request.auth.token.email
        && str(request.resource.data.displayName, 80)
        && str(request.resource.data.city, 60)
        && (
          // New member sign-up: pays the joining fee and waits for an admin.
          (request.resource.data.keys().hasOnly(['displayName','email','photoURL','city','instagram','whatsapp','bio','status','role','createdAt','phoneKey','accountType'])
            && request.resource.data.status == 'pending')
          ||
          // General user (not an RCMI member): just registers, active straight away, no member number.
          (request.resource.data.keys().hasOnly(['displayName','email','photoURL','city','instagram','whatsapp','bio','status','role','createdAt','approvedAt','phoneKey','accountType'])
            && request.resource.data.status == 'approved'
            && request.resource.data.accountType == 'general')
          ||
          // Registered phone number: active straight away as that member (each record can be claimed once).
          (request.resource.data.keys().hasOnly(['displayName','email','photoURL','city','instagram','whatsapp','bio','status','role','createdAt','memberNo','rosterId','approvedAt','phoneKey','accountType'])
            && request.resource.data.status == 'approved'
            && request.resource.data.get('accountType', 'member') == 'member'
            && request.resource.data.phoneKey is string
            && exists(/databases/$(database)/documents/phoneInvites/$(request.resource.data.phoneKey))
            && request.resource.data.rosterId == phoneInvite(request.resource.data.phoneKey).rosterId
            && request.resource.data.memberNo == phoneInvite(request.resource.data.phoneKey).memberNo
            && rosterFree(request.resource.data.rosterId))
          ||
          // Registered Google email: same, keyed by the verified email.
          (hasInvite()
            && request.resource.data.keys().hasOnly(['displayName','email','photoURL','city','instagram','whatsapp','bio','status','role','createdAt','memberNo','rosterId','approvedAt','accountType'])
            && request.resource.data.status == 'approved'
            && request.resource.data.get('accountType', 'member') == 'member'
            && request.resource.data.memberNo == invite().memberNo
            && request.resource.data.rosterId == invite().rosterId
            && rosterFree(invite().rosterId))
        );

      // Members can edit their own profile details, never their status, role or number.
      allow update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayName','city','instagram','whatsapp','bio','photoURL','updatedAt','emailOff'])
          && str(request.resource.data.displayName, 80))
        || admin()
        // Moderator: approve a pending general user …
        || (mod() && resource.data.get('accountType', 'member') == 'general' && resource.data.status == 'pending'
            && request.resource.data.status == 'approved' && onlyKeys(['status', 'approvedAt']))
        // … or deactivate / reactivate an account that isn't an admin or moderator.
        || (mod() && uid != request.auth.uid && resource.data.get('role', 'member') == 'member'
            && resource.data.status in ['approved', 'deactivated'] && request.resource.data.status in ['approved', 'deactivated']
            && onlyKeys(['status', 'deactivatedAt', 'reactivatedAt']));

      // Admins; or the person themselves after a rejection, so they can sign up again.
      allow delete: if admin() || (signedIn() && request.auth.uid == uid && resource.data.status == 'rejected')
        || (mod() && resource.data.get('accountType', 'member') == 'general' && resource.data.status == 'pending');
    }

    // ---------- Photo contests ----------
    // Phases: draft (admins only) → open (entries) → voting (public vote + jury) → judging (jury only) → closed (winners announced).
    // Jury = users with role 'jury', chosen per contest in 'judges'. Admins run everything.
    function jury() { return approved() && me().role == 'jury'; }
    match /contests/{cid} {
      function c() { return get(/databases/$(database)/documents/contests/$(cid)).data; }
      function own(uid) { return signedIn() && request.auth.uid == uid; }
      allow read: if resource.data.get('public', false) == true || admin();
      allow create, update, delete: if admin();

      // One entry per person (doc id = their uid). Others' entries stay hidden while entries are open.
      match /entries/{uid} {
        allow read: if admin() || own(uid) || (c().get('public', false) == true && c().status != 'open');
        allow create, update: if approved() && own(uid) && c().status == 'open'
          && !(uid in c().get('judges', [])) && me().get('role', 'member') != 'jury'
          && request.resource.data.keys().hasOnly(['uid', 'name', 'avatar', 'title', 'caption', 'photo', 'at'])
          && request.resource.data.uid == uid
          && str(request.resource.data.title, 80) && request.resource.data.title.size() > 0
          && str(request.resource.data.caption, 500) && str(request.resource.data.name, 80) && str(request.resource.data.avatar, 500)
          && request.resource.data.photo is string && request.resource.data.photo.size() > 0 && request.resource.data.photo.size() < 900000;
        allow update: if admin() && onlyKeys(['status', 'disqReason', 'votes', 'jury', 'final', 'rank']);
        allow delete: if (own(uid) && c().status == 'open') || admin();
      }
      // Public vote: one per signed-in account (doc id = voter uid), can be moved while voting is open; not for your own entry.
      // Who voted for whom stays private (you see only your own); the totals are published on the entries at the end.
      match /votes/{voter} {
        allow read: if admin() || own(voter);
        allow create, update: if approved() && own(voter) && c().status == 'voting'
          && request.resource.data.keys().hasOnly(['entry', 'at'])
          && request.resource.data.entry is string && request.resource.data.entry != voter
          && get(/databases/$(database)/documents/contests/$(cid)/entries/$(request.resource.data.entry)).data.get('status', 'ok') == 'ok';
        allow delete: if (own(voter) && c().status == 'voting') || admin();
      }
      // Jury scores: one per judge per entry (id = judge_entry). A judge sees only their own; admins see all.
      match /scores/{sid} {
        allow read: if admin() || (signedIn() && resource.data.judge == request.auth.uid);
        allow create, update: if jury() && request.auth.uid in c().get('judges', []) && c().status in ['voting', 'judging']
          && sid == request.auth.uid + '_' + request.resource.data.entry
          && request.resource.data.keys().hasOnly(['judge', 'entry', 'crit', 'total', 'note', 'at'])
          && request.resource.data.judge == request.auth.uid
          && exists(/databases/$(database)/documents/contests/$(cid)/entries/$(request.resource.data.entry))
          && request.resource.data.crit is map && request.resource.data.total is number
          && request.resource.data.total >= 1 && request.resource.data.total <= 10 && str(request.resource.data.note, 500);
        allow delete: if admin();
      }
    }

    // Phone push notifications: each device's Firebase Cloud Messaging token, written by its owner.
    match /users/{uid}/push/{token} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at', 'ua']) && str(request.resource.data.ua, 200);
    }

    // Seller contact (name + WhatsApp) for the market — readable by any approved account, written by its owner.
    match /contacts/{uid} {
      allow read: if approved();
      allow delete: if staff();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'whatsapp', 'instagram'])
        && str(request.resource.data.name, 80) && str(request.resource.data.whatsapp, 20);
    }

    // Imported roster (from the Google Form): number, name, province — visible to members.
    match /roster/{id} {
      allow read: if member() || admin();
      allow write: if admin();
      // A member activated by phone/email links their account to their own (still unclaimed) record.
      allow update: if approved() && me().rosterId == id
        && (!('claimedBy' in resource.data) || resource.data.claimedBy == null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy'])
        && request.resource.data.claimedBy == request.auth.uid;
    }
    // Phone invites: looked up by the exact number someone types; never listable except by admins.
    match /phoneInvites/{phone} {
      allow get: if signedIn();
      allow list, write: if admin();
    }
    // Email invites: the signed-in person can read only the invite for their own verified email.
    match /invites/{email} {
      allow get: if signedIn() && request.auth.token.email_verified == true && email == myEmail();
      allow list, write: if admin();
    }
    // Phone numbers and T-shirt orders — admins only.
    match /rosterPrivate/{id} {
      allow read, write: if admin();
    }

    // ---------- Monthly dues ----------
    // Payment settings (bank account, amount, due day) — members read, admins edit.
    match /settings/{id} {
      // Payment details (bank / QRIS) are also shown to new members paying the joining fee.
      allow read: if member() || admin() || (signedIn() && id == 'payment');
      allow write: if admin();
    }
    // One document per member per month: dues/{rosterId}_{YYYY-MM}.
    // Members see and submit only their own; admins confirm, reject, waive or mark paid.
    match /dues/{dueId} {
      function mine(d) { return approved() && d.rosterId == me().rosterId; }
      function validSubmit(d) {
        return d.uid == request.auth.uid
          && d.status == 'pending'
          && d.month is string && d.month.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
          && dueId == d.rosterId + '_' + d.month
          && d.proof is string && d.proof.size() < 400000;
      }
      allow read: if admin() || mine(resource.data);
      allow create: if admin() || (mine(request.resource.data) && validSubmit(request.resource.data));
      allow update: if admin() || (mine(resource.data) && resource.data.status != 'paid'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proof','note','submittedAt','status','uid','name','memberNo'])
        && validSubmit(request.resource.data));
      allow delete: if admin();
    }

    // ---------- Finance (Laba Rugi) ----------
    // The treasurer's ledger (imported from the KEUANGAN RCMI sheet).
    // Members can view the report (finance/ledger); only admins import/sync and see the sheet link (finance/source).
    match /finance/{id} {
      allow read: if admin() || (id == 'ledger' && member());
      allow write: if admin();
    }

    // Blocked sign-ups: by Google email, and by phone number (looked up by exact key only, never listed).
    match /blocked/{email} {
      allow get: if (signedIn() && email == myEmail()) || admin();
      allow list, write: if admin();
    }
    match /blockedPhones/{key} {
      allow get: if signedIn();
      allow list, write: if admin();
    }

    // Joining-fee proof from a new member waiting for approval: the applicant and admins only.
    match /joinPayments/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || admin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['proof','createdAt'])
        && str(request.resource.data.proof, 400000) && request.resource.data.proof.matches('data:image/.*')
        && request.resource.data.createdAt == request.time;
      allow delete: if admin();
    }

    // "X commented on your post" / "X replied to your comment": any active account, but only to the real
    // owner of that post / author of that comment.
    function commentNotice() {
      let d = request.resource.data;
      let col = d.target == 'market' ? 'listings' : 'cars';
      return approved()
        && d.kind in ['comment', 'reply', 'claim', 'like', 'rate', 'review'] && d.target in ['collection', 'market']
        && (!(d.kind in ['rate', 'review']) || d.target == 'market')
        && d.from == request.auth.uid && d.uid != request.auth.uid
        && d.keys().hasOnly(['uid', 'kind', 'target', 'postId', 'parentId', 'title', 'note', 'from', 'fromName', 'at', 'read'])
        && d.read == false && d.at == request.time
        && str(d.note, 200) && str(d.title, 100) && str(d.fromName, 80) && d.postId is string
        && (d.kind in ['comment', 'claim', 'like', 'review']
              ? get(/databases/$(database)/documents/$(col)/$(d.postId)).data.ownerUid == d.uid
              : d.kind == 'rate'
              ? (get(/databases/$(database)/documents/listings/$(d.postId)).data.ownerUid == request.auth.uid
                 && (get(/databases/$(database)/documents/listings/$(d.postId)).data.get('buyerUid', '') == d.uid
                     || exists(/databases/$(database)/documents/listings/$(d.postId)/claims/$(d.uid))))
              : (d.parentId is string && get(/databases/$(database)/documents/$(col)/$(d.postId)/comments/$(d.parentId)).data.uid == d.uid));
    }

    // Owner deletes a collection post: the reason is kept for the admins.
    match /deleteLog/{id} {
      allow read, delete: if staff();
      allow create: if approved()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'target', 'postId', 'title', 'reason', 'at'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.at == request.time
        && request.resource.data.target == 'collection' && request.resource.data.postId is string
        && str(request.resource.data.reason, 300) && request.resource.data.reason.size() >= 5
        && str(request.resource.data.title, 100) && str(request.resource.data.name, 80);
    }

    // Seller reviews: only the buyer of a sold listing (or a war slot holder), once per sale; the seller can reply once.
    match /reviews/{id} {
      allow read: if true;
      allow create: if approved()
        && request.resource.data.keys().hasOnly(['listingId', 'sellerUid', 'sellerName', 'title', 'reviewerUid', 'reviewerName', 'stars', 'asDescribed', 'text', 'at'])
        && id == request.resource.data.listingId + '_' + request.auth.uid
        && request.resource.data.reviewerUid == request.auth.uid && request.resource.data.sellerUid != request.auth.uid
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.asDescribed is bool && request.resource.data.at == request.time
        && str(request.resource.data.text, 300) && str(request.resource.data.title, 100)
        && str(request.resource.data.reviewerName, 80) && str(request.resource.data.sellerName, 80)
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.status == 'sold'
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.ownerUid == request.resource.data.sellerUid
        && (get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.get('buyerUid', '') == request.auth.uid
            || exists(/databases/$(database)/documents/listings/$(request.resource.data.listingId)/claims/$(request.auth.uid)));
      allow update: if signedIn() && resource.data.sellerUid == request.auth.uid && !('reply' in resource.data)
        && onlyKeys(['reply', 'replyAt']) && str(request.resource.data.reply, 300) && request.resource.data.replyAt == request.time;
      allow delete: if staff();
    }

    // Direct messages: only the two people in a chat can read it; admins/moderators only after one of them reports it.
    function inChat(c) { return signedIn() && request.auth.uid in c.members; }
    match /chats/{chatId} {
      allow read: if (signedIn() && request.auth.uid in resource.data.members) || (staff() && resource.data.get('reported', false) == true);
      // Checking whether a chat exists yet (before starting one) only reveals that it doesn't.
      allow get: if signedIn() && resource == null;
      allow create: if approved()
        && request.resource.data.keys().hasOnly(['members', 'names', 'photos', 'createdAt', 'lastAt', 'lastText', 'lastFrom', 'readAt', 'blockedBy'])
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] != request.resource.data.members[1]
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.blockedBy.size() == 0 && request.resource.data.lastText == '';
      allow update: if (signedIn() && request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members
          && onlyKeys(['lastText', 'lastAt', 'lastFrom', 'readAt', 'names', 'photos', 'blockedBy', 'reported', 'reportedBy', 'reportNote', 'reportedAt'])
          && str(request.resource.data.lastText, 120)
          && (!('lastFrom' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.lastFrom == request.auth.uid)
          && (!('reportedBy' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.reportedBy == request.auth.uid)
          // Each person can only add or remove themselves from the block list.
          && (!('blockedBy' in request.resource.data.diff(resource.data).affectedKeys())
              || request.resource.data.blockedBy.toSet().difference(resource.data.blockedBy.toSet()).union(resource.data.blockedBy.toSet().difference(request.resource.data.blockedBy.toSet())).hasOnly([request.auth.uid])))
        || (staff() && resource.data.get('reported', false) == true && onlyKeys(['reported']));

      match /messages/{mid} {
        allow read: if inChat(get(/databases/$(database)/documents/chats/$(chatId)).data)
          || (staff() && get(/databases/$(database)/documents/chats/$(chatId)).data.get('reported', false) == true);
        allow create: if approved()
          && inChat(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && get(/databases/$(database)/documents/chats/$(chatId)).data.get('blockedBy', []).size() == 0
          && request.resource.data.keys().hasOnly(['from', 'text', 'photo', 'at'])
          && request.resource.data.from == request.auth.uid && request.resource.data.at == request.time
          && str(request.resource.data.text, 1000) && str(request.resource.data.photo, 400000);
        allow delete: if (signedIn() && resource.data.from == request.auth.uid) || admin();
      }
    }

    // Shipping address: private — only the person and admins can read it.
    match /addresses/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || admin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['recipient', 'phone', 'street', 'village', 'district', 'city', 'province', 'postal', 'note', 'updatedAt'])
        && str(request.resource.data.recipient, 80) && request.resource.data.recipient.size() > 0
        && str(request.resource.data.phone, 20) && request.resource.data.phone.size() > 0
        && str(request.resource.data.street, 300) && request.resource.data.street.size() > 0
        && str(request.resource.data.village, 80) && str(request.resource.data.district, 80) && request.resource.data.district.size() > 0
        && str(request.resource.data.city, 80) && request.resource.data.city.size() > 0
        && str(request.resource.data.province, 60) && request.resource.data.province.size() > 0
        && str(request.resource.data.postal, 10) && str(request.resource.data.note, 200)
        && request.resource.data.updatedAt == request.time;
      allow delete: if (signedIn() && request.auth.uid == uid) || admin();
    }

    // Notices to a user from the admins (e.g. "your post was hidden", with the reason).
    match /notices/{id} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || admin();
      allow create: if admin() || commentNotice()
        || (mod() && request.resource.data.kind in ['deleted', 'delapproved', 'delrejected']);
      allow update: if (signedIn() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])) || admin();
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || admin();
    }

    // Contact form: signed-in users can send a message (tied to their account); only admins can read and manage them.
    match /messages/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name','contact','topic','message','status','createdAt','uid','email','lang'])
        && str(request.resource.data.name, 80) && request.resource.data.name.size() > 0
        && str(request.resource.data.contact, 120) && request.resource.data.contact.size() > 0
        && str(request.resource.data.topic, 40)
        && str(request.resource.data.message, 2000) && request.resource.data.message.size() > 0
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow read, update, delete: if admin();
    }

    // Public numbers for the home page (total members, provinces). Anyone reads; admins write.
    match /public/{id} {
      allow read: if true;
      allow write: if admin();
    }

    // Links to the admin's private Google Sheets used for syncing (members). Admins only.
    match /sources/{id} {
      allow read, write: if admin();
    }

    // Member-number counter, managed by admins during approval.
    match /counters/{id} {
      allow read, write: if admin();
    }

    // ---------- Collection showcase ----------
    match /cars/{carId} {
      // Public: the Collection feed on the main website shows everyone's cars.
      allow read: if true;
      // Any active account (RCMI members and general users) can post to the Collection.
      allow create: if approved()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.get('hidden', false) == false
        && !request.resource.data.keys().hasAny(['modHidden', 'modNote', 'modBy', 'modAt'])
        && str(request.resource.data.name, 100)
        && carPhotosOk(request.resource.data.photos);
      // Owners can't change 'hidden' (deactivated account) or the admin moderation fields.
      allow update: if (approved() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hidden', 'modHidden', 'modNote', 'modBy', 'modAt'])
          && carPhotosOk(request.resource.data.photos) && str(request.resource.data.name, 100)
          && editOnce(['name', 'maker', 'notes', 'photos', 'editedAt'])) || admin()
        || likeOnly() || (mod() && onlyKeys(['hidden']));
      allow delete: if (approved() && resource.data.ownerUid == request.auth.uid) || staff();
    }

    // Likes (collection posts & market listings): any active account can add or remove only its own uid in likedBy.
    function likeOnly() {
      return approved()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
        && request.resource.data.likedBy is list && request.resource.data.likedBy.size() <= 5000
        && ((request.resource.data.likedBy.toSet().difference(resource.data.get('likedBy', []).toSet()) == [request.auth.uid].toSet()
             && resource.data.get('likedBy', []).toSet().difference(request.resource.data.likedBy.toSet()).size() == 0)
         || (resource.data.get('likedBy', []).toSet().difference(request.resource.data.likedBy.toSet()) == [request.auth.uid].toSet()
             && request.resource.data.likedBy.toSet().difference(resource.data.get('likedBy', []).toSet()).size() == 0));
    }

    // War buy: a buyer takes (or gives back) one slot. Not the seller; only while open; never more than qty.
    function warClaim(listingId) {
      let claims = /databases/$(database)/documents/listings/$(listingId)/claims/$(request.auth.uid);
      return approved() && resource.data.get('war', false) == true
        && resource.data.ownerUid != request.auth.uid
        && resource.data.get('status', 'open') != 'sold'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed'])
        && ((request.resource.data.claimed == resource.data.get('claimed', 0) + 1
              && request.resource.data.claimed <= resource.data.qty
              && (resource.data.get('warStart', null) == null || resource.data.warStart <= request.time)
              && !exists(claims) && existsAfter(claims))
          || (request.resource.data.claimed == resource.data.get('claimed', 0) - 1
              && exists(claims) && !existsAfter(claims)));
    }

    // Comments (and replies: parent = the comment replied to) on collection posts and market listings.
    // Anyone can read; active accounts can write; the author, the post's owner and admins can delete.
    function commentOk() {
      let d = request.resource.data;
      return approved() && d.uid == request.auth.uid
        && d.keys().hasOnly(['uid', 'name', 'photo', 'text', 'at', 'parent', 'replyToName'])
        && str(d.text, 500) && d.text.size() > 0
        && str(d.name, 80) && str(d.photo, 600)
        && (!('parent' in d) || d.parent is string) && (!('replyToName' in d) || str(d.replyToName, 80))
        && d.at == request.time;
    }
    match /cars/{carId}/comments/{cid} {
      allow read: if true;
      allow create: if commentOk();
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || admin()
        || (signedIn() && get(/databases/$(database)/documents/cars/$(carId)).data.ownerUid == request.auth.uid);
    }
    match /listings/{listingId}/comments/{cid} {
      allow read: if true;
      // No new comments once the seller marks the listing sold.
      allow create: if commentOk() && get(/databases/$(database)/documents/listings/$(listingId)).data.get('status', 'open') != 'sold';
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || admin()
        || (signedIn() && get(/databases/$(database)/documents/listings/$(listingId)).data.ownerUid == request.auth.uid);
    }

    // ---------- Events & meetups ----------
    match /events/{eventId} {
      allow read: if approved();
      allow write: if admin();

      match /rsvps/{uid} {
        allow read: if approved();
        allow create, delete: if approved() && request.auth.uid == uid;
      }
    }

    // ---------- Marketplace / trade ----------
    // Public market: anyone can browse; only approved members post. Phone numbers never stored in listings.
    match /listings/{listingId} {
      allow read: if true;
      allow create: if approved()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.get('hidden', false) == false
        && !request.resource.data.keys().hasAny(['modHidden', 'modNote', 'modBy', 'modAt'])
        && request.resource.data.type in ['sell','trade','wanted']
        // Market rule 3: every listing has a price (budget for wanted, value for trade).
        && request.resource.data.price is number && request.resource.data.price > 0
        // War buy: limited quantity, first come first served.
        && (!('war' in request.resource.data) || (request.resource.data.war == true && request.resource.data.type == 'sell'
              && request.resource.data.qty is int && request.resource.data.qty >= 1 && request.resource.data.qty <= 500
              && request.resource.data.claimed == 0
              && (!('warStart' in request.resource.data) || request.resource.data.warStart == null || request.resource.data.warStart is timestamp)))
        && !('ownerWhatsapp' in request.resource.data)
        && str(request.resource.data.title, 100)
        && photosOk(request.resource.data.photos);
      // Owners can't change 'hidden' (deactivated account) or the admin moderation fields.
      allow update: if (approved() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hidden', 'modHidden', 'modNote', 'modBy', 'modAt'])
          && photosOk(request.resource.data.photos)
          && str(request.resource.data.title, 100)
          // Editing keeps the market rules: a valid type, a real price, and war stock never below the slots taken.
          && (request.resource.data.type == resource.data.type || (!resource.data.get('war', false) && request.resource.data.type in ['sell','trade','wanted']))
          && (request.resource.data.get('price', 0) == resource.data.get('price', 0) || (request.resource.data.price is number && request.resource.data.price > 0))
          && request.resource.data.get('war', false) == resource.data.get('war', false)
          && request.resource.data.get('claimed', 0) <= resource.data.get('claimed', 0)
          && (!resource.data.get('war', false) || (request.resource.data.qty is int && request.resource.data.qty <= 500 && request.resource.data.qty >= request.resource.data.get('claimed', 0)))
          && !('ownerWhatsapp' in request.resource.data)
          && editOnce(['title', 'price', 'type', 'condition', 'description', 'photos', 'qty', 'editedAt'])) || admin() || likeOnly() || warClaim(listingId)
        || (mod() && onlyKeys(['hidden', 'delReq', 'delReason']));
      // Sellers can't delete a listing themselves: they send a delete request (delReq + a reason) and an admin or moderator approves it.
      allow delete: if staff();

      // War buy slots: one per account; the listing's 'claimed' counter moves by exactly one in the same transaction.
      match /claims/{uid} {
        allow read: if true;
        allow create: if approved() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'photo', 'n', 'at'])
          && request.resource.data.uid == uid && request.resource.data.at == request.time
          && str(request.resource.data.name, 80) && str(request.resource.data.photo, 600)
          && getAfter(/databases/$(database)/documents/listings/$(listingId)).data.claimed == get(/databases/$(database)/documents/listings/$(listingId)).data.get('claimed', 0) + 1
          && request.resource.data.n == getAfter(/databases/$(database)/documents/listings/$(listingId)).data.claimed
          // Never more slots than the stock, and never the seller (whatever role they have).
          && getAfter(/databases/$(database)/documents/listings/$(listingId)).data.claimed <= get(/databases/$(database)/documents/listings/$(listingId)).data.qty
          && get(/databases/$(database)/documents/listings/$(listingId)).data.ownerUid != request.auth.uid;
        allow delete: if admin()
          || (signedIn() && get(/databases/$(database)/documents/listings/$(listingId)).data.ownerUid == request.auth.uid)
          || (signedIn() && uid == request.auth.uid
              && getAfter(/databases/$(database)/documents/listings/$(listingId)).data.claimed == get(/databases/$(database)/documents/listings/$(listingId)).data.claimed - 1);
      }
    }
  }
}
