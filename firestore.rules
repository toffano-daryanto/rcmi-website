rules_version = '2';

// RCMI — Resin Car Model Indonesia
// Two account types (users.accountType):
//   - "member"  (RCMI member; older accounts without the field count as members)
//   - "general" (signed-in non-member, approved by an admin)
// Who can do what:
//   - Everyone, signed in or not: browse the market.
//   - Approved members AND general users: post in the market, see sellers' WhatsApp, events + RSVP, view the collection.
//   - Approved members only: member list & profiles, member card, monthly dues, adding cars to the collection.
//   - Admins approve sign-ups, assign member numbers and manage events.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function approved() { return hasProfile() && me().status == 'approved'; }
    function admin() { return approved() && me().role == 'admin'; }
    function member() { return approved() && me().get('accountType', 'member') == 'member'; }
    function str(v, max) { return v is string && v.size() <= max; }
    function photosOk(p) { return p is list && p.size() <= 3; }
    // Collection posts: up to 10 photos you can swipe through (all inside the 1 MB document).
    function carPhotosOk(p) { return p is list && p.size() <= 10; }
    // Pre-registered members: admins add invites/{gmail} → { rosterId, memberNo }.
    // A verified Google account with that email activates itself without waiting for approval.
    function myEmail() { return request.auth.token.email.lower(); }
    function invitePath() { return /databases/$(database)/documents/invites/$(myEmail()); }
    function hasInvite() { return signedIn() && request.auth.token.email_verified == true && exists(invitePath()); }
    function invite() { return get(invitePath()).data; }
    // Phone matching: phoneInvites/{62812…} → { rosterId, memberNo }. The member types the number they registered.
    function phoneInvite(key) { return get(/databases/$(database)/documents/phoneInvites/$(key)).data; }
    function rosterDoc(id) { return get(/databases/$(database)/documents/roster/$(id)).data; }
    function rosterFree(id) { return !('claimedBy' in rosterDoc(id)) || rosterDoc(id).claimedBy == null; }

    // ---------- Members ----------
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || member() || admin();

      allow create: if signedIn() && request.auth.uid == uid
        // Blocked by an admin (by Google email or phone number): can't register again.
        && !exists(/databases/$(database)/documents/blocked/$(myEmail()))
        && (!('phoneKey' in request.resource.data) || !exists(/databases/$(database)/documents/blockedPhones/$(request.resource.data.phoneKey)))
        && request.resource.data.role == 'member'
        && request.resource.data.get('accountType', 'member') in ['member', 'general']
        && request.resource.data.email == request.auth.token.email
        && str(request.resource.data.displayName, 80)
        && str(request.resource.data.city, 60)
        && (
          // New member sign-up: pays the joining fee and waits for an admin.
          (request.resource.data.keys().hasOnly(['displayName','email','photoURL','city','instagram','whatsapp','bio','status','role','createdAt','phoneKey','accountType'])
            && request.resource.data.status == 'pending')
          ||
          // General user (not an RCMI member): just registers, active straight away, no member number.
          (request.resource.data.keys().hasOnly(['displayName','email','photoURL','city','instagram','whatsapp','bio','status','role','createdAt','approvedAt','phoneKey','accountType'])
            && request.resource.data.status == 'approved'
            && request.resource.data.accountType == 'general')
          ||
          // Registered phone number: active straight away as that member (each record can be claimed once).
          (request.resource.data.keys().hasOnly(['displayName','email','photoURL','city','instagram','whatsapp','bio','status','role','createdAt','memberNo','rosterId','approvedAt','phoneKey','accountType'])
            && request.resource.data.status == 'approved'
            && request.resource.data.get('accountType', 'member') == 'member'
            && request.resource.data.phoneKey is string
            && exists(/databases/$(database)/documents/phoneInvites/$(request.resource.data.phoneKey))
            && request.resource.data.rosterId == phoneInvite(request.resource.data.phoneKey).rosterId
            && request.resource.data.memberNo == phoneInvite(request.resource.data.phoneKey).memberNo
            && rosterFree(request.resource.data.rosterId))
          ||
          // Registered Google email: same, keyed by the verified email.
          (hasInvite()
            && request.resource.data.keys().hasOnly(['displayName','email','photoURL','city','instagram','whatsapp','bio','status','role','createdAt','memberNo','rosterId','approvedAt','accountType'])
            && request.resource.data.status == 'approved'
            && request.resource.data.get('accountType', 'member') == 'member'
            && request.resource.data.memberNo == invite().memberNo
            && request.resource.data.rosterId == invite().rosterId
            && rosterFree(invite().rosterId))
        );

      // Members can edit their own profile details, never their status, role or number.
      allow update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayName','city','instagram','whatsapp','bio','photoURL','updatedAt'])
          && str(request.resource.data.displayName, 80))
        || admin();

      // Admins; or the person themselves after a rejection, so they can sign up again.
      allow delete: if admin() || (signedIn() && request.auth.uid == uid && resource.data.status == 'rejected');
    }

    // Seller contact (name + WhatsApp) for the market — readable by any approved account, written by its owner.
    match /contacts/{uid} {
      allow read: if approved();
      allow delete: if admin();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'whatsapp', 'instagram'])
        && str(request.resource.data.name, 80) && str(request.resource.data.whatsapp, 20);
    }

    // Imported roster (from the Google Form): number, name, province — visible to members.
    match /roster/{id} {
      allow read: if member() || admin();
      allow write: if admin();
      // A member activated by phone/email links their account to their own (still unclaimed) record.
      allow update: if approved() && me().rosterId == id
        && (!('claimedBy' in resource.data) || resource.data.claimedBy == null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy'])
        && request.resource.data.claimedBy == request.auth.uid;
    }
    // Phone invites: looked up by the exact number someone types; never listable except by admins.
    match /phoneInvites/{phone} {
      allow get: if signedIn();
      allow list, write: if admin();
    }
    // Email invites: the signed-in person can read only the invite for their own verified email.
    match /invites/{email} {
      allow get: if signedIn() && request.auth.token.email_verified == true && email == myEmail();
      allow list, write: if admin();
    }
    // Phone numbers and T-shirt orders — admins only.
    match /rosterPrivate/{id} {
      allow read, write: if admin();
    }

    // ---------- Monthly dues ----------
    // Payment settings (bank account, amount, due day) — members read, admins edit.
    match /settings/{id} {
      // Payment details (bank / QRIS) are also shown to new members paying the joining fee.
      allow read: if member() || admin() || (signedIn() && id == 'payment');
      allow write: if admin();
    }
    // One document per member per month: dues/{rosterId}_{YYYY-MM}.
    // Members see and submit only their own; admins confirm, reject, waive or mark paid.
    match /dues/{dueId} {
      function mine(d) { return approved() && d.rosterId == me().rosterId; }
      function validSubmit(d) {
        return d.uid == request.auth.uid
          && d.status == 'pending'
          && d.month is string && d.month.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
          && dueId == d.rosterId + '_' + d.month
          && d.proof is string && d.proof.size() < 400000;
      }
      allow read: if admin() || mine(resource.data);
      allow create: if admin() || (mine(request.resource.data) && validSubmit(request.resource.data));
      allow update: if admin() || (mine(resource.data) && resource.data.status != 'paid'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proof','note','submittedAt','status','uid','name','memberNo'])
        && validSubmit(request.resource.data));
      allow delete: if admin();
    }

    // ---------- Finance (Laba Rugi) ----------
    // The treasurer's ledger (imported from the KEUANGAN RCMI sheet).
    // Members can view the report (finance/ledger); only admins import/sync and see the sheet link (finance/source).
    match /finance/{id} {
      allow read: if admin() || (id == 'ledger' && member());
      allow write: if admin();
    }

    // Blocked sign-ups: by Google email, and by phone number (looked up by exact key only, never listed).
    match /blocked/{email} {
      allow get: if (signedIn() && email == myEmail()) || admin();
      allow list, write: if admin();
    }
    match /blockedPhones/{key} {
      allow get: if signedIn();
      allow list, write: if admin();
    }

    // Joining-fee proof from a new member waiting for approval: the applicant and admins only.
    match /joinPayments/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || admin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['proof','createdAt'])
        && str(request.resource.data.proof, 400000) && request.resource.data.proof.matches('data:image/.*')
        && request.resource.data.createdAt == request.time;
      allow delete: if admin();
    }

    // "X commented on your post" / "X replied to your comment": any active account, but only to the real
    // owner of that post / author of that comment.
    function commentNotice() {
      let d = request.resource.data;
      let col = d.target == 'market' ? 'listings' : 'cars';
      return approved()
        && d.kind in ['comment', 'reply'] && d.target in ['collection', 'market']
        && d.from == request.auth.uid && d.uid != request.auth.uid
        && d.keys().hasOnly(['uid', 'kind', 'target', 'postId', 'parentId', 'title', 'note', 'from', 'fromName', 'at', 'read'])
        && d.read == false && d.at == request.time
        && str(d.note, 200) && str(d.title, 100) && str(d.fromName, 80) && d.postId is string
        && (d.kind == 'comment'
              ? get(/databases/$(database)/documents/$(col)/$(d.postId)).data.ownerUid == d.uid
              : (d.parentId is string && get(/databases/$(database)/documents/$(col)/$(d.postId)/comments/$(d.parentId)).data.uid == d.uid));
    }

    // Notices to a user from the admins (e.g. "your post was hidden", with the reason).
    match /notices/{id} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || admin();
      allow create: if admin() || commentNotice();
      allow update: if (signedIn() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])) || admin();
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || admin();
    }

    // Contact form: signed-in users can send a message (tied to their account); only admins can read and manage them.
    match /messages/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name','contact','topic','message','status','createdAt','uid','email','lang'])
        && str(request.resource.data.name, 80) && request.resource.data.name.size() > 0
        && str(request.resource.data.contact, 120) && request.resource.data.contact.size() > 0
        && str(request.resource.data.topic, 40)
        && str(request.resource.data.message, 2000) && request.resource.data.message.size() > 0
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow read, update, delete: if admin();
    }

    // Public numbers for the home page (total members, provinces). Anyone reads; admins write.
    match /public/{id} {
      allow read: if true;
      allow write: if admin();
    }

    // Links to the admin's private Google Sheets used for syncing (members). Admins only.
    match /sources/{id} {
      allow read, write: if admin();
    }

    // Member-number counter, managed by admins during approval.
    match /counters/{id} {
      allow read, write: if admin();
    }

    // ---------- Collection showcase ----------
    match /cars/{carId} {
      // Public: the Collection feed on the main website shows everyone's cars.
      allow read: if true;
      allow create: if member()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.get('hidden', false) == false
        && !request.resource.data.keys().hasAny(['modHidden', 'modNote', 'modBy', 'modAt'])
        && str(request.resource.data.name, 100)
        && carPhotosOk(request.resource.data.photos);
      // Owners can't change 'hidden' (deactivated account) or the admin moderation fields.
      allow update: if (approved() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hidden', 'modHidden', 'modNote', 'modBy', 'modAt'])
          && carPhotosOk(request.resource.data.photos)) || admin()
        // Likes: any active account can add or remove only its own uid in likedBy.
        || (approved()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
          && request.resource.data.likedBy is list && request.resource.data.likedBy.size() <= 5000
          && ((request.resource.data.likedBy.toSet().difference(resource.data.get('likedBy', []).toSet()) == [request.auth.uid].toSet()
               && resource.data.get('likedBy', []).toSet().difference(request.resource.data.likedBy.toSet()).size() == 0)
           || (resource.data.get('likedBy', []).toSet().difference(request.resource.data.likedBy.toSet()) == [request.auth.uid].toSet()
               && request.resource.data.likedBy.toSet().difference(resource.data.get('likedBy', []).toSet()).size() == 0)));
      allow delete: if (approved() && resource.data.ownerUid == request.auth.uid) || admin();
    }

    // Comments (and replies: parent = the comment replied to) on collection posts and market listings.
    // Anyone can read; active accounts can write; the author, the post's owner and admins can delete.
    function commentOk() {
      let d = request.resource.data;
      return approved() && d.uid == request.auth.uid
        && d.keys().hasOnly(['uid', 'name', 'photo', 'text', 'at', 'parent', 'replyToName'])
        && str(d.text, 500) && d.text.size() > 0
        && str(d.name, 80) && str(d.photo, 600)
        && (!('parent' in d) || d.parent is string) && (!('replyToName' in d) || str(d.replyToName, 80))
        && d.at == request.time;
    }
    match /cars/{carId}/comments/{cid} {
      allow read: if true;
      allow create: if commentOk();
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || admin()
        || (signedIn() && get(/databases/$(database)/documents/cars/$(carId)).data.ownerUid == request.auth.uid);
    }
    match /listings/{listingId}/comments/{cid} {
      allow read: if true;
      allow create: if commentOk();
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || admin()
        || (signedIn() && get(/databases/$(database)/documents/listings/$(listingId)).data.ownerUid == request.auth.uid);
    }

    // ---------- Events & meetups ----------
    match /events/{eventId} {
      allow read: if approved();
      allow write: if admin();

      match /rsvps/{uid} {
        allow read: if approved();
        allow create, delete: if approved() && request.auth.uid == uid;
      }
    }

    // ---------- Marketplace / trade ----------
    // Public market: anyone can browse; only approved members post. Phone numbers never stored in listings.
    match /listings/{listingId} {
      allow read: if true;
      allow create: if approved()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.get('hidden', false) == false
        && !request.resource.data.keys().hasAny(['modHidden', 'modNote', 'modBy', 'modAt'])
        && request.resource.data.type in ['sell','trade','wanted']
        // Market rule 3: every listing has a price (budget for wanted, value for trade).
        && request.resource.data.price is number && request.resource.data.price > 0
        && !('ownerWhatsapp' in request.resource.data)
        && str(request.resource.data.title, 100)
        && photosOk(request.resource.data.photos);
      // Owners can't change 'hidden' (deactivated account) or the admin moderation fields.
      allow update: if (approved() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hidden', 'modHidden', 'modNote', 'modBy', 'modAt'])
          && photosOk(request.resource.data.photos)) || admin();
      allow delete: if (approved() && resource.data.ownerUid == request.auth.uid) || admin();
    }
  }
}
